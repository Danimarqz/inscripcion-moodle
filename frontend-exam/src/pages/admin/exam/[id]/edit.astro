---
import ExamForm from '../../../../components/ExamForm.tsx';
import Layout from '../../../../layouts/Layout.astro';

export const prerender = false;

const examId = Number(Astro.params.id);
---
<Layout title="Crear o editar examen">
  <a
    href="/admin/exams"
    class="inline-block mb-6 px-4 py-2 font-bold text-purple-300 border border-purple-300 rounded-md no-underline transition-colors duration-300 ease-in-out hover:bg-purple-300 hover:text-[#1a1c22]"
    >
      &larr; Volver a la gestión de exámenes
  </a>
  <ExamForm client:load examId={examId} />
</Layout>
