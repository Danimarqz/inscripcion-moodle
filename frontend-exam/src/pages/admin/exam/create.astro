---
import ExamForm from '../../../components/ExamForm.tsx';
import Layout from '../../../layouts/Layout.astro';

const { examToEdit } = Astro.props;

function onSuccess(examId: number) {
  window.location.href = `/admin`;
}
---

<Layout title="Crear o editar examen">
  <ExamForm client:load examToEdit={examToEdit} onSuccess={onSuccess} />
</Layout>