---
import Layout from '../../layouts/Layout.astro';
import AdminExamsManager from '../../components/AdminExamsManager.tsx';
---

<Layout title="Gestion de examenes">
    <a
      href="/admin/dashboard"
      class="inline-block mb-6 px-4 py-2 font-bold text-brand-pink border border-brand-pink rounded-md no-underline transition-colors duration-300 ease-in-out hover:bg-brand-yellow hover:text-dark-200"
      >
        &larr; Volver al dashboard
    </a>
    <div class="max-w-5xl mx-auto my-8 p-8 bg-[#1a1c22] rounded-lg shadow-2xl text-white">
      <header class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-brand-pink">Gestion de examenes</h1>
          <p class="text-sm text-gray-400">Crea, edita o elimina examenes disponibles.</p>
        </div>
        <div class="flex gap-3">
          <a
            class="py-2 px-5 rounded font-semibold cursor-pointer transition-all duration-300 no-underline inline-block border-none text-dark-200 bg-brand-pink hover:bg-brand-yellow hover:-translate-y-0.5"
            href="/admin/exam/create"
          >
            Crear nuevo examen
          </a>
        </div>
      </header>
  <AdminExamsManager client:only="preact" />
    </div>
</Layout>
