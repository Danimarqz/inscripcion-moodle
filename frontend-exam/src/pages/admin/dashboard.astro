---
import Layout from "../../layouts/Layout.astro";
import AdminDashboard from "../../components/AdminDashboard.tsx";

const adminLinks = [
  {
    href: "/admin/exams",
    title: "Gestionar exámenes",
    description: "Crea, edita o elimina exámenes disponibles para los usuarios.",
  },
  {
    href: "/admin/submissions",
    title: "Gestionar intentos",
    description: "Revisa y actualiza los intentos enviados por los opositores.",
  },
  {
    href: "/admin/results",
    title: "Resultados oficiales",
    description: "Importa PDFs oficiales y comprueba su coincidencia con los envíos.",
  },
];
---

<Layout title="Panel de administración">
  <section class="max-w-5xl mx-auto my-12 space-y-10 text-white">
    <header class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="space-y-2">
        <h1 class="text-3xl font-bold text-purple-300">Panel de administración</h1>
        <p class="text-sm text-gray-400">
          Selecciona una sección para gestionar los contenidos del simulador o revisar los resultados oficiales.
        </p>
      </div>
      <AdminDashboard client:only="preact" className="w-full md:w-auto" />
    </header>

    <p class="text-sm text-gray-500">
      Recuerda cerrar sesión al terminar para mantener la seguridad del panel.
    </p>

    <div class="grid gap-6 md:grid-cols-3">
      {adminLinks.map((link) => (
        <a
          href={link.href}
          class="block bg-[#1a1c22] p-6 rounded-lg shadow-lg border border-transparent transition-transform duration-200 hover:-translate-y-1 hover:border-purple-500 hover:bg-[#23252d]"
        >
          <h2 class="text-xl font-semibold text-purple-200 mb-2">{link.title}</h2>
          <p class="text-sm text-gray-300">{link.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
