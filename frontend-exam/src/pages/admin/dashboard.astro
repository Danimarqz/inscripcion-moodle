---
import Layout from '../../layouts/Layout.astro';
import { removeAuthToken } from '../../services/adminService';

// Client-side logout function (still needed for the button)
const logout = () => {
  removeAuthToken();
  window.location.href = '/admin/login';
};
---

<Layout title="Admin Dashboard">
  <main>
    <h1>Admin Dashboard</h1>
    <p>Bienvenido al panel de administración.</p>
    <div id="exams-list-container">
      <p>Cargando exámenes...</p>
    </div>
    <button id="logout-button" class="submit-button">Cerrar Sesión</button>
  </main>
</Layout>

<script>
  import { getAuthToken, removeAuthToken, getExamsAdmin } from '../../services/adminService';
  import type { Exam } from '../../types/exam';

  document.addEventListener('DOMContentLoaded', async () => {
    const authToken = getAuthToken();
    if (!authToken) {
      window.location.href = '/admin/login';
      return;
    }

    const examsListContainer = document.getElementById('exams-list-container');
    const logoutButton = document.getElementById('logout-button');

    if (!examsListContainer || !logoutButton) {
      console.error('Required DOM elements not found.');
      return;
    }

    logoutButton.addEventListener('click', () => {
      removeAuthToken();
      window.location.href = '/admin/login';
    });

    try {
      const exams: Exam[] = await getExamsAdmin(authToken);
      if (exams.length === 0) {
        examsListContainer.innerHTML = '<p>No hay exámenes disponibles.</p>';
      } else {
        let examsHtml = '<h2>Exámenes Disponibles</h2><ul>';
        exams.forEach(exam => {
          examsHtml += `<li>${exam.name} (ID: ${exam.id})</li>`;
        });
        examsHtml += '</ul>';
        examsListContainer.innerHTML = examsHtml;
      }
    } catch (error: any) {
      console.error('Error fetching exams:', error);
      examsListContainer.innerHTML = `<p class="error-message">Error al cargar los exámenes: ${error.message}</p>`;
    }
  });
</script>

<style>
  main {
    margin: auto;
    padding: 2rem;
    width: 90%;
    max-width: 800px;
    color: white;
    font-size: 1.1rem;
    line-height: 1.6;
    background-color: #1a1c22;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 2rem;
    color: rgb(var(--accent-light));
  }

  h2 {
    font-size: 1.8rem;
    color: rgb(var(--accent));
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    background-color: #2a2d33;
    border: 1px solid #444;
    border-radius: 5px;
    padding: 0.8rem;
    margin-bottom: 0.5rem;
  }

  .submit-button {
    display: block;
    width: 100%;
    padding: 1rem;
    background-color: rgb(var(--accent));
    color: white;
    border: none;
    border-radius: 5px;
    font-size: 1.2rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    margin-top: 2rem;
  }

  .submit-button:hover {
    background-color: rgb(var(--accent-light));
    transform: translateY(-2px);
  }

  .error-message {
    color: #ff6b6b;
    text-align: center;
    font-size: 1rem;
    margin-top: 1rem;
    padding: 0.8rem;
    background-color: rgba(255, 107, 107, 0.1);
    border-radius: 8px;
    border: 1px solid #ff6b6b;
  }
</style>
