---
import Layout from '../../layouts/Layout.astro';
import AdminResultsPage from '../../components/AdminResultsPage.tsx';
---

<Layout title="Resultados oficiales">
    <a
      href="/admin/dashboard"
      class="inline-block mb-6 px-4 py-2 font-bold text-brand-pink border border-brand-pink rounded-md no-underline transition-colors duration-300 ease-in-out hover:bg-brand-yellow hover:text-dark-200"
      >
        &larr; Volver al dashboard
    </a>
    <div class="max-w-5xl mx-auto my-8 p-8 bg-[#1a1c22] rounded-lg shadow-2xl text-white">
      <header class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-brand-pink">Resultados oficiales</h1>
          <p class="text-sm text-gray-400">Importa el PDF oficial y revisa la coincidencia con usuarios registrados.</p>
        </div>
      </header>
      <AdminResultsPage client:only="preact" />
    </div>
</Layout>
