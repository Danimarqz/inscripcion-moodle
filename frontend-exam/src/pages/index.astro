---
import Layout from '../layouts/Layout.astro';
import IndexPage from '../components/IndexPage.tsx';
---

<Layout title="Welcome to OpositaTest">
  <main>
    <IndexPage client:load />
  </main>
</Layout>

<style>
  main {
    position: relative; /* Para posicionar el botón o lo que quieras */
    margin: auto;
    padding: 2rem;
    width: 90%;
    max-width: 1000px;
    color: white;
    font-size: 1.1rem;
    line-height: 1.6;
    background-color: #1a1c22;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }
  h1 {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
    margin-bottom: 1.5em;
    text-shadow: 0 0 15px rgba(var(--accent), 0.7);
  }
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
    transition: background-position 0.8s ease-in-out;
  }
  .text-gradient:hover {
    background-position: 100%;
  }
  .link-card-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    padding: 0;
    list-style: none;
  }
  .error,
  .no-exams {
    color: #ff6b6b;
    text-align: center;
    font-size: 1.3rem;
    margin-top: 2rem;
    padding: 1rem;
    background-color: rgba(255, 107, 107, 0.1);
    border-radius: 8px;
    border: 1px solid #ff6b6b;
  }
  .no-exams {
    color: #6bff6b;
    background-color: rgba(107, 255, 107, 0.1);
    border: 1px solid #6bff6b;
  }
</style>
